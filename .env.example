# VisaMotion 365 — optional server-side keys.
# Copy to `.env.local` for local dev, or add these in Vercel → Project → Settings → Environment Variables.
# They are optional: the app also works with keys pasted in the in-app Settings (stored in localStorage).
# Never commit real keys.

# Real Browser Use Cloud runs (single prompt → autonomous browser task)
BROWSER_USE_API_KEY=

# Optional server-side defaults for real AI chat
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Base44 AI-agent workflow (drives the agent answers)
BASE44_API_KEY=
BASE44_ENDPOINT=
